# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/cantek

# Comma-separated list of emails that get admin rights
ADMIN_EMAILS=admin@example.com

# SMTP server used to send emails (e.g. Gmail with an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-app-password

# Secret used to sign JWT tokens (use a long random string)
SECRET_KEY=change-me-to-a-long-random-string

# Google Gemini API (AI-assisted quote requests)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Public URL of the frontend (used in email links)
FRONTEND_URL=http://localhost:5173
